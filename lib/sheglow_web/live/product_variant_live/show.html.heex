<.header>
  Product variant {@product_variant.id}
  <:subtitle>This is a product_variant record from your database.</:subtitle>
  <:actions>
    <.link patch={~p"/product_variants/#{@product_variant}/show/edit"} phx-click={JS.push_focus()}>
      <.button>Edit product_variant</.button>
    </.link>
  </:actions>
</.header>

<.list>
  <:item title="Color name">{@product_variant.color_name}</:item>
  <:item title="Color hex">{@product_variant.color_hex}</:item>
  <:item title="Size">{@product_variant.size}</:item>
  <:item title="Stock quantity">{@product_variant.stock_quantity}</:item>
</.list>

<.back navigate={~p"/product_variants"}>Back to product_variants</.back>

<.modal :if={@live_action == :edit} id="product_variant-modal" show on_cancel={JS.patch(~p"/product_variants/#{@product_variant}")}>
  <.live_component
    module={SheglowWeb.ProductVariantLive.FormComponent}
    id={@product_variant.id}
    title={@page_title}
    action={@live_action}
    product_variant={@product_variant}
    patch={~p"/product_variants/#{@product_variant}"}
  />
</.modal>
