<.header>
  Bundle item {@bundle_item.id}
  <:subtitle>This is a bundle_item record from your database.</:subtitle>
  <:actions>
    <.link patch={~p"/bundle_items/#{@bundle_item}/show/edit"} phx-click={JS.push_focus()}>
      <.button>Edit bundle_item</.button>
    </.link>
  </:actions>
</.header>

<.list>
</.list>

<.back navigate={~p"/bundle_items"}>Back to bundle_items</.back>

<.modal :if={@live_action == :edit} id="bundle_item-modal" show on_cancel={JS.patch(~p"/bundle_items/#{@bundle_item}")}>
  <.live_component
    module={SheglowWeb.BundleItemLive.FormComponent}
    id={@bundle_item.id}
    title={@page_title}
    action={@live_action}
    bundle_item={@bundle_item}
    patch={~p"/bundle_items/#{@bundle_item}"}
  />
</.modal>
